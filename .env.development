# Database Configuration
POSTGRES_USER=autolounge_dev
POSTGRES_PASSWORD=dev_password
POSTGRES_DB=autolounge_dev
POSTGRES_PORT=5432

# Database URL for Prisma
DATABASE_URL=postgresql://autolounge_dev:dev_password@localhost:5432/autolounge_dev?schema=public

# JWT Configuration
JWT_SECRET=dev_secret_key_change_in_production

# API Configuration
API_PORT=5000
ALLOWED_ORIGINS=http://localhost:3000

# SMS Service (Development)
SMS_API_KEY=test_api_key
SMS_API_SECRET=test_api_secret

# Web/Next.js Configuration
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics
NEXT_PUBLIC_GA_ID=

# Node Environment
NODE_ENV=development
