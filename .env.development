# AutoLounge — local development (docker-compose.dev.yml provides Postgres on localhost)

# ---- PostgreSQL ----
POSTGRES_USER=autolounge_dev
POSTGRES_PASSWORD=dev_password
POSTGRES_DB=autolounge_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://autolounge_dev:dev_password@localhost:5432/autolounge_dev?schema=public

# ---- API ----
NODE_ENV=development
API_PORT=5000
JWT_SECRET=dev_secret_key_change_in_production
ALLOWED_ORIGINS=http://localhost:3000
WEB_URL=http://localhost:3000
PAYMENT_CALLBACK_URL=http://localhost:3000/checkout/callback
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_FROM=
OTP_DEV_BYPASS_CODE=123456
ADMIN_PHONE=09120000000
SEED_ON_START=true

# ---- Web (Next.js) ----
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:5000
INTERNAL_API_URL=http://localhost:5000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=
