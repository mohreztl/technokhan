# AutoLounge web — copy to .env.local

# Browser-facing API host (no /api/v1 suffix)
NEXT_PUBLIC_API_URL=http://localhost:5000
# Server-side API host (inside Docker: http://api:5000)
INTERNAL_API_URL=http://localhost:5000
# Canonical site URL (sitemap, metadata, share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# true → transactional endpoints are served from localStorage and the demo banner is shown
NEXT_PUBLIC_DEMO_MODE=false
# GA4 measurement id (G-XXXXXXXXXX), optional
NEXT_PUBLIC_GA_MEASUREMENT_ID=
