# AutoLounge Environment Variables
# Copy this file to .env.local and fill in the values

# =============================================================================
# SITE CONFIGURATION
# =============================================================================
NEXT_PUBLIC_SITE_URL=https://autolounge.ir
NEXT_PUBLIC_API_URL=http://localhost:3001

# =============================================================================
# ZARINPAL PAYMENT GATEWAY
# =============================================================================
# Get your merchant ID from https://panel.zarinpal.com/
NEXT_PUBLIC_ZARINPAL_MERCHANT_ID=your-merchant-id-here
NEXT_PUBLIC_ZARINPAL_CALLBACK_URL=https://autolounge.ir/checkout/callback
# Set to 'true' for testing with sandbox, 'false' for production
NEXT_PUBLIC_ZARINPAL_SANDBOX=true

# =============================================================================
# GOOGLE ANALYTICS
# =============================================================================
# GA4 Measurement ID (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# =============================================================================
# SMS PROVIDER (Kavenegar)
# =============================================================================
KAVENEGAR_API_KEY=your-kavenegar-api-key

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/autolounge

# =============================================================================
# AUTHENTICATION
# =============================================================================
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d

# =============================================================================
# FILE STORAGE (Optional - for image uploads)
# =============================================================================
# S3-compatible storage
S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
S3_BUCKET=autolounge
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_REGION=ir-thr-at1
