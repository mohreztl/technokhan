generator client {
  provider = "prisma-client-js"
}

// The connection string lives in prisma.config.ts — Prisma 7 rejects `url` here.
datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  customer
}

enum OrderStatus {
  pending
  processing
  shipped
  delivered
  cancelled
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum PaymentMethod {
  zarinpal
  cod
}

enum BookingStatus {
  pending
  confirmed
  in_progress
  completed
  cancelled
}

model User {
  id          String   @id @default(cuid())
  phoneNumber String   @unique
  name        String?
  email       String?
  role        UserRole @default(customer)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings  Booking[]
  orders    Order[]
  addresses Address[]
  reviews   Review[]

  @@index([phoneNumber])
  @@index([role])
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  fullName    String
  phoneNumber String
  province    String
  city        String
  address     String   @db.Text
  postalCode  String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OTP {
  id          String   @id @default(cuid())
  phoneNumber String
  code        String // bcrypt hash of the 6-digit code
  expiresAt   DateTime
  used        Boolean  @default(false)
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([phoneNumber, code])
  @@index([phoneNumber, expiresAt])
}

model Product {
  id               String   @id @default(cuid())
  name             String
  nameEn           String
  description      String   @db.Text
  descriptionEn    String   @db.Text
  shortDescription String?
  price            Float
  discountPrice    Float?
  category         String
  images           String[]
  stock            Int      @default(0)
  featured         Boolean  @default(false)
  isActive         Boolean  @default(true)
  brand            String?
  sku              String?
  specifications   Json?
  features         String[] @default([])
  tags             String[] @default([])
  rating           Float?   @default(0)
  reviewCount      Int      @default(0)
  colors           Json?
  warranties       Json?
  salesCount       Int      @default(0)
  editorChoice     Boolean  @default(false)
  dealEndsAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orderItems OrderItem[]
  reviews    Review[]

  @@index([category])
  @@index([featured])
  @@index([isActive])
}

model Service {
  id               String   @id @default(cuid())
  name             String
  nameEn           String
  description      String   @db.Text
  descriptionEn    String   @db.Text
  shortDescription String?
  price            Float
  duration         Int // in minutes
  type             String
  images           String[]
  featured         Boolean  @default(false)
  isActive         Boolean  @default(true)
  features         String[] @default([])
  steps            Json?
  faq              Json?
  pricing          Json?
  addons           Json?
  gallery          String[] @default([])
  beforeAfter      Json?
  warrantyMonths   Int?
  tags             String[] @default([])
  rating           Float?   @default(0)
  reviewCount      Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  bookings Booking[]
  reviews  Review[]

  @@index([type])
  @@index([featured])
  @@index([isActive])
}

model Review {
  id           String   @id @default(cuid())
  userId       String
  userName     String
  productId    String?
  serviceId    String?
  rating       Int // 1-5
  comment      String?  @db.Text
  helpfulCount Int      @default(0)
  isApproved   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([productId])
  @@index([serviceId])
  @@index([isApproved])
}

model Booking {
  id           String        @id @default(cuid())
  userId       String
  serviceId    String
  date         DateTime
  timeSlot     String
  location     String
  carModel     String
  carYear      Int
  carColor     String
  carPlate     String?
  vehicleSize  String?
  addonIds     String[]      @default([])
  notes        String?       @db.Text
  status       BookingStatus @default(pending)
  totalPrice   Float
  trackingCode String?       @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user         User                 @relation(fields: [userId], references: [id])
  service      Service              @relation(fields: [serviceId], references: [id])
  transactions PaymentTransaction[]

  @@index([userId])
  @@index([serviceId])
  @@index([date])
  @@index([status])
}

model Order {
  id              String        @id @default(cuid())
  userId          String
  subtotal        Float         @default(0)
  discount        Float         @default(0)
  shippingCost    Float         @default(0)
  totalPrice      Float
  shippingAddress Json
  status          OrderStatus   @default(pending)
  paymentStatus   PaymentStatus @default(pending)
  paymentMethod   PaymentMethod @default(zarinpal)
  couponCode      String?
  /// The shop's own code (OR-XXXXXX), given to the customer and never changed
  trackingCode    String?       @unique
  /// The courier's consignment number, set by an admin when the order ships
  shipmentCode    String?
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user         User                 @relation(fields: [userId], references: [id])
  items        OrderItem[]
  transactions PaymentTransaction[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  selection Json?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model PaymentTransaction {
  id           String   @id @default(cuid())
  orderId      String?
  bookingId    String?
  amount       Float
  authority    String?  @unique
  refId        String?
  status       String   @default("pending")
  gateway      String   @default("zarinpal")
  cardNumber   String?
  errorCode    String?
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  order   Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([bookingId])
  @@index([authority])
  @@index([status])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  subject   String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
}

enum CouponType {
  percent
  fixed
}

/// Discount codes. These used to be a hard-coded list in @autolounge/shared;
/// the bundled list is now only the demo catalogue.
model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  type        CouponType
  value       Float
  description String
  minTotal    Float?
  maxDiscount Float?
  expiresAt   DateTime?
  isActive    Boolean    @default(true)
  /// Total redemptions allowed; null means unlimited
  usageLimit  Int?
  usedCount   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([isActive])
}

/// A single row (id = "default") holding what the shop can change without a
/// deploy: when it is open, when it is not, and how to reach it.
model SiteSettings {
  id             String   @id @default("default")
  /// JS getDay() values the workshop is closed on (0 = Sunday, 5 = Friday)
  closedWeekdays Int[]    @default([5])
  /// One-off closures as yyyy-MM-dd — holidays, Nowruz, maintenance
  closedDates    String[] @default([])
  /// Bookable windows, e.g. "08:00 - 10:00"
  timeSlots      String[] @default([])
  phone          String   @default("")
  mobile         String   @default("")
  email          String   @default("")
  address        String   @default("")
  workingHours   String   @default("")
  instagram      String   @default("")
  telegram       String   @default("")
  whatsapp       String   @default("")
  updatedAt      DateTime @updatedAt
}
