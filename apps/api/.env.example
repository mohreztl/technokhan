# Database
DATABASE_URL="postgresql://user:password@localhost:5432/autolounge?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# MeliPayamak SMS Gateway
MELIPAYAMAK_USERNAME="your-melipayamak-username"
MELIPAYAMAK_PASSWORD="your-melipayamak-password"
MELIPAYAMAK_FROM="your-sender-number"

# Server
PORT=3001
NODE_ENV=development

# CORS
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"
