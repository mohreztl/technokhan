# AutoLounge API — copy to .env

# ---- Server ----
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
LOG_LEVEL=debug
# Trust X-Forwarded-* headers (set to true behind nginx / a load balancer)
TRUST_PROXY=false

# ---- Database ----
DATABASE_URL="postgresql://autolounge_dev:dev_password@localhost:5432/autolounge_dev?schema=public"

# ---- Auth ----
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN=7d
# Demo OTP accepted outside production and returned as `demoCode` by /auth/send-otp (empty = disabled)
OTP_DEV_BYPASS_CODE=123456
# Phone number that receives the admin role (seed + first login)
ADMIN_PHONE=09120000000

# ---- Web / CORS ----
WEB_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
# Default Zarinpal return URL (defaults to ${WEB_URL}/checkout/callback)
PAYMENT_CALLBACK_URL=http://localhost:3000/checkout/callback

# ---- Zarinpal (empty merchant id → simulated DEMO gateway outside production) ----
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# ---- MeliPayamak SMS (empty → OTP is logged to the console instead of sent) ----
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_FROM=

# ---- Ops ----
# Run `prisma db seed` after migrations when the container starts
SEED_ON_START=true
# Timezone used for "today" / "past slot" booking rules
BOOKING_TIMEZONE=Asia/Tehran
# Global rate limit per IP
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW="1 minute"
