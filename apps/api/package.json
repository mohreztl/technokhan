    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.0",
    "fastify": "^5.12.5",
