# AutoLounge — Docker Compose environment. Copy to .env and adjust.

# ---- PostgreSQL ----
POSTGRES_USER=autolounge
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_DB=autolounge
POSTGRES_PORT=5432
# Prisma connection string (inside the compose network the host is `postgres`)
DATABASE_URL=postgresql://autolounge:change_this_strong_password@postgres:5432/autolounge?schema=public

# ---- API ----
NODE_ENV=production
API_PORT=5000
JWT_SECRET=change_this_to_a_very_strong_random_secret_key
ALLOWED_ORIGINS=http://localhost:3000
WEB_URL=http://localhost:3000
PAYMENT_CALLBACK_URL=http://localhost:3000/checkout/callback
# Zarinpal — empty merchant id enables the demo gateway outside production
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
# MeliPayamak — empty credentials log OTPs instead of sending SMS
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_FROM=
# Demo OTP (only honoured when NODE_ENV != production)
OTP_DEV_BYPASS_CODE=
ADMIN_PHONE=09120000000
SEED_ON_START=true

# ---- Web (Next.js) ----
WEB_PORT=3000
# Browser-facing API host (baked into the web image at build time)
NEXT_PUBLIC_API_URL=http://localhost:5000
# Server-side API host inside the compose network
INTERNAL_API_URL=http://api:5000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=false
# GA4 measurement id (G-XXXXXXXXXX), optional
NEXT_PUBLIC_GA_MEASUREMENT_ID=
