# AutoLounge — Docker Compose environment. Copy to .env and adjust.

# ---- PostgreSQL ----
POSTGRES_USER=autolounge
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_DB=autolounge
POSTGRES_PORT=5432
# Prisma connection string (inside the compose network the host is `postgres`)
DATABASE_URL=postgresql://autolounge:change_this_strong_password@postgres:5432/autolounge?schema=public

# ---- API ----
NODE_ENV=production
API_PORT=5000
JWT_SECRET=change_this_to_a_very_strong_random_secret_key
ALLOWED_ORIGINS=http://localhost:3000
WEB_URL=http://localhost:3000
PAYMENT_CALLBACK_URL=http://localhost:3000/checkout/callback
# Payment gateway: zarinpal or zibal
PAYMENT_PROVIDER=zarinpal
# Zarinpal — empty merchant id enables the demo gateway outside production
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
# Zibal — https://help.zibal.ir (merchant code from the Zibal panel)
ZIBAL_MERCHANT_ID=
# SMS — mellipayamak (default) or kavenegar; empty credentials log OTPs instead of sending SMS
SMS_PROVIDER=mellipayamak
SMS_BRAND_NAME=تکنو خان
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_FROM=
# Melli Payamak pattern-OTP body id (خدماتی); 0 sends a plain SMS instead
MELIPAYAMAK_OTP_BODY_ID=0
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
# Sepidar accounting (همکاران سیستم) — product/stock source of truth.
# Same values as the Sepidar plugin settings in the old WordPress panel.
SEPIDAR_BASE_URL=
SEPIDAR_USERNAME=
SEPIDAR_PASSWORD=
SEPIDAR_PRICE_LIST_ID=0
#SEPIDAR_ITEMS_PATH=/api/Item/GetItems
#SEPIDAR_STOCK_PATH=/api/Stock/GetStocks
# Basalam marketplace seller (basalam.com → پنل فروشنده → API)
BASALAM_TOKEN=
BASALAM_VENDOR_ID=
# S3-compatible object storage for admin image uploads (e.g. Parspack)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_PREFIX=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
# Public base URL of the bucket/prefix, e.g. https://<bucket>.parspack.net/<bucket>/<prefix>
S3_PUBLIC_URL=
# WordPress migration (one env set per project — technokhan / aryatechno)
WP_URL=
WP_USER=
WP_APP_PASSWORD=
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
MIGRATION_EXPORT_DIR=./data/exports
# AI image pipeline (tools/image-pipeline)
OPENAI_API_KEY=
AI_IMAGE_MODEL=gpt-image-1
IMAGE_BRAND_NAME=تکنو خان
# Demo OTP (only honoured when NODE_ENV != production)
OTP_DEV_BYPASS_CODE=
ADMIN_PHONE=09120000000
SEED_ON_START=true

# ---- Web (Next.js) ----
WEB_PORT=3000
# Browser-facing API host (baked into the web image at build time)
NEXT_PUBLIC_API_URL=http://localhost:5000
# Server-side API host inside the compose network
INTERNAL_API_URL=http://api:5000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=false
# Public S3 base URL — lets next/image serve uploaded images (same value as S3_PUBLIC_URL)
NEXT_PUBLIC_S3_PUBLIC_URL=
# GA4 measurement id (G-XXXXXXXXXX), optional
NEXT_PUBLIC_GA_MEASUREMENT_ID=
