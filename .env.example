# Database Configuration
POSTGRES_USER=autolounge
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_DB=autolounge
POSTGRES_PORT=5432

# Database URL for Prisma
DATABASE_URL=postgresql://autolounge:change_this_strong_password@postgres:5432/autolounge?schema=public

# JWT Configuration
JWT_SECRET=change_this_to_a_very_strong_random_secret_key

# API Configuration
API_PORT=5000
ALLOWED_ORIGINS=http://localhost:3000

# SMS Service (e.g., Kavenegar, SMS.ir)
SMS_API_KEY=your_sms_api_key
SMS_API_SECRET=your_sms_api_secret

# Web/Next.js Configuration
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics (Optional)
NEXT_PUBLIC_GA_ID=

# Node Environment
NODE_ENV=production
