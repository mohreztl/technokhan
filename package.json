{
  "name": "technokhan",
  "version": "1.0.0",
  "private": true,
  "description": "TechnoKhan (تکنو خان) - Persian Smart Gadget Storefront",
  "author": "mohreztl",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @technokhan/shared build && pnpm --parallel --filter \"./apps/**\" --filter @technokhan/shared dev",
    "dev:web": "pnpm --filter @technokhan/shared build && pnpm --filter web dev",
    "dev:api": "pnpm --filter @technokhan/shared build && pnpm --filter api dev",
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @technokhan/shared build",
    "build:web": "pnpm --filter @technokhan/shared build && pnpm --filter web build",
    "build:api": "pnpm --filter @technokhan/shared build && pnpm --filter api build",
    "start:web": "pnpm --filter web start",
    "start:api": "pnpm --filter api start",
    "lint": "pnpm --filter \"./apps/**\" lint",
    "type-check": "pnpm --filter @technokhan/shared build && pnpm -r type-check",
    "test": "pnpm -r test",
    "assets": "pnpm --filter @technokhan/shared build && pnpm --filter web assets",
    "db:migrate": "pnpm --filter api prisma:migrate",
    "db:seed": "pnpm --filter api db:seed",
    "db:studio": "pnpm --filter api prisma:studio"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.11.0+sha512.6540583f41cc5f628eb3d9773ecee802f4f9ef9923cc45b69890fb47991d4b092964694ec3a4f738a420c918a333062c8b925d312f42e4f0c263eb603551f977"
}
